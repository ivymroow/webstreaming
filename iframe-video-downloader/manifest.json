{
  "manifest_version": 3,
  "name": "embed downloader",
  "version": "1.0.0",
  "description": "detect and download direct video files and unencrypted HLS streams from pages and embedded iframes.",
  "permissions": ["downloads", "storage", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "embed downloader" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start"
  }]
}
