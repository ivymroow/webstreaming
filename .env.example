NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed in production.
CORS_ORIGINS=https://your-railway-app.up.railway.app,http://localhost:8080
PUBLIC_URL=https://web-streaming.site

# Supabase project credentials. Keep real values in Railway variables, not git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TMDB_KEY=your-tmdb-api-key
SESSION_SECRET=generate-a-long-random-secret

# Render/free-tier tuning.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
MAX_ACTIVE_STREAMS=8
STREAM_IDLE_MS=600000
STREAM_CLEANUP_INTERVAL_MS=60000
DOWNLOAD_TIMEOUT_MS=480000
DOWNLOAD_RETENTION_MS=900000
FFMPEG_TIMEOUT_MS=30000
